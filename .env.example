# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Auth routes (must match src/features/auth/constants.ts)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Phone-on-LAN testing: in Clerk Dashboard → Configure → Domains,
# add http://YOUR_LAN_IP:3000 (e.g. http://192.168.31.142:3000) as an allowed origin.
# Also restart `pnpm dev` after next.config allowedDevOrigins changes.

# Neon Postgres — https://console.neon.tech
# Local + Vercel Preview: use the staging branch connection string
# Vercel Production: use the production branch connection string
DATABASE_URL=

# Razorpay (optional until payments phase)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# AWS S3 — image uploads (POST /api/upload presigned-URL flow)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Optional: CDN / custom domain serving the bucket (defaults to the S3 URL)
# S3_PUBLIC_BASE_URL=
